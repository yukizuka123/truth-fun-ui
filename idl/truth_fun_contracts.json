  "types": [
    {
      "name": "Market",
      "docs": [
        "Single-vault design:",
        "",
        "usdc_vault holds ALL USDC from both YES and NO curve activity plus",
        "the keeper's DFlow redemption deposit.",
        "",
        "vault.amount invariant (holds at every instruction boundary):",
        "vault = curve_usdc_reserve   (YES buyers net)",
        "+ bonus_pool_usdc      (YES vig)",
        "+ curve_no_reserve     (NO buyers net)",
        "+ bonus_pool_no_usdc   (NO vig)",
        "+ resolution_usdc_deposited  (keeper DFlow redemption proceeds)",
        "",
        "At mark_resolved, total_resolution_pot = vault.amount (snapshotted once).",
        "Both YES and NO claims draw from the same pot with their respective",
        "supply denominators, so no cross-vault transfer is ever needed."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "dflow_yes_mint",
            "docs": [
              "Seeds this market PDA: [b\"market\", dflow_yes_mint]."
            ],
            "type": "pubkey"
          },
          {
            "name": "dflow_no_mint",
            "type": "pubkey"
          },
          {
            "name": "settlement_mint",
            "docs": [
              "Settlement stablecoin — USDC."
            ],
            "type": "pubkey"
          },
          {
            "name": "tf_yes_mint",
            "type": "pubkey"
          },
          {
            "name": "curve_yes_supply",
            "docs": [
              "x — tfYES unissued pool supply"
            ],
            "type": "u64"
          },
          {
            "name": "virtual_yes_reserve",
            "docs": [
              "Virtual USDC reserve — anchors the curve to the Kalshi starting price.",
              "NOT held in the vault. = seed_yes × dflow_yes_price_bps / 10_000"
            ],
            "type": "u64"
          },
          {
            "name": "curve_usdc_reserve",
            "docs": [
              "YES buyers' net USDC in usdc_vault. Effective YES price uses virtual + this."
            ],
            "type": "u64"
          },
          {
            "name": "k",
            "docs": [
              "k_yes = seed_yes × virtual_yes_reserve, immutable after creation."
            ],
            "type": "u128"
          },
          {
            "name": "total_dflow_yes_locked",
            "type": "u64"
          },
          {
            "name": "total_tf_yes_minted",
            "type": "u64"
          },
          {
            "name": "resolution_usdc_deposited",
            "docs": [
              "Keeper's DFlow YES/NO redemption USDC deposited before mark_resolved."
            ],
            "type": "u64"
          },
          {
            "name": "total_tf_yes_at_resolution",
            "docs": [
              "Frozen at mark_resolved — denominator for YES claim payouts."
            ],
            "type": "u64"
          },
          {
            "name": "tf_no_mint",
            "type": "pubkey"
          },
          {
            "name": "curve_no_supply",
            "type": "u64"
          },
          {
            "name": "virtual_no_reserve",
            "docs": [
              "virtual_no_reserve = seed_no × dflow_no_price_bps / 10_000"
            ],
            "type": "u64"
          },
          {
            "name": "curve_no_reserve",
            "docs": [
              "NO buyers' net USDC in usdc_vault (same vault as YES)."
            ],
            "type": "u64"
          },
          {
            "name": "k_no",
            "type": "u128"
          },
          {
            "name": "total_dflow_no_locked",
            "type": "u64"
          },
          {
            "name": "total_tf_no_minted",
            "type": "u64"
          },
          {
            "name": "total_tf_no_at_resolution",
            "docs": [
              "Frozen at mark_resolved — denominator for NO claim payouts."
            ],
            "type": "u64"
          },
          {
            "name": "bonus_pool_usdc",
            "docs": [
              "1% vig from trades — stays in usdc_vault, included in resolution pot."
            ],
            "type": "u64"
          },
          {
            "name": "total_resolution_pot",
            "docs": [
              "Snapshotted at mark_resolved = usdc_vault.amount at that moment.",
              "Stable divisor: claims never race because this doesn't change post-settle.",
              "",
              "For YES winner: payout = amount × pot / total_tf_yes_at_resolution",
              "For NO  winner: payout = amount × pot / total_tf_no_at_resolution"
            ],
            "type": "u64"
          },
          {
            "name": "close_time",
            "type": "i64"
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "MarketStatus"
              }
            }
          },
          {
            "name": "winning_side",
            "type": {
              "defined": {
                "name": "WinningSide"
              }
            }
          },
          {
            "name": "vig_bps",
            "type": "u16"
          },
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "platform",
            "type": "pubkey"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }

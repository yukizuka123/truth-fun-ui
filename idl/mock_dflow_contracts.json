  "types": [
    {
      "name": "MockDflowMarket",
      "docs": [
        "On-chain state for one mock DFlow market.",
        "",
        "Mirrors the minimal DFlow market structure needed by Truth.fun:",
        "- yesMint / noMint  →  dflowYES / dflowNO SPL mints",
        "- USDC vault        →  holds redemption capital deposited by keeper",
        "- price bps         →  mock Kalshi price feed updated by arb bot",
        "",
        "PDA seeds: [b\"dflow_market\", market_id]",
        "where market_id is a caller-supplied Pubkey (unique per Kalshi event)."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Keeper wallet that controls this market."
            ],
            "type": "pubkey"
          },
          {
            "name": "market_id",
            "docs": [
              "Unique per-market identifier — also used as PDA seed."
            ],
            "type": "pubkey"
          },
          {
            "name": "settlement_mint",
            "docs": [
              "USDC (or any settlement token) mint."
            ],
            "type": "pubkey"
          },
          {
            "name": "yes_mint",
            "docs": [
              "Mock dflowYES mint — PDA owned by this market."
            ],
            "type": "pubkey"
          },
          {
            "name": "no_mint",
            "docs": [
              "Mock dflowNO mint — PDA owned by this market."
            ],
            "type": "pubkey"
          },
          {
            "name": "usdc_vault",
            "docs": [
              "USDC vault — keeper deposits here before calling redeem_*."
            ],
            "type": "pubkey"
          },
          {
            "name": "yes_price_bps",
            "docs": [
              "Current YES price in bps  (6500 = $0.65).  Updated by arb bot."
            ],
            "type": "u64"
          },
          {
            "name": "no_price_bps",
            "docs": [
              "Current NO  price in bps  (3500 = $0.35)."
            ],
            "type": "u64"
          },
          {
            "name": "total_yes_minted",
            "docs": [
              "Total dflowYES tokens currently in circulation."
            ],
            "type": "u64"
          },
          {
            "name": "total_no_minted",
            "docs": [
              "Total dflowNO tokens currently in circulation."
            ],
            "type": "u64"
          },
          {
            "name": "is_resolved",
            "type": "bool"
          },
          {
            "name": "winning_side",
            "type": {
